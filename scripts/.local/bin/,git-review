#!/usr/bin/env bash

# Review a PR or stack as unstaged changes
set -euo pipefail

branch=${1:?usage: $0 <branch> [base-branch]}
base_branch=${2:-main}
base=$(git merge-base "$base_branch" "$branch")

git switch -c "review/$branch" "$branch"
git reset --mixed "$base"

# Add any untracked files from the branch to the unstaged area
git diff -z --name-only --diff-filter=A "$base" "$branch" |
  while IFS= read -r -d '' f; do git add -N -- "$f"; done

git diff --stat
