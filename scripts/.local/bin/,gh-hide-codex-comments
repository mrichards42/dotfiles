#!/usr/bin/env bash
# Hide codex noise on each branch's PR: "@codex review" triggers, codex's
# top-level comments once every codex thread is resolved, and codex review
# bodies once their own threads are resolved. Dry run unless --apply.
#
# usage: ,gh-hide-codex-comments [--apply] [BRANCH...]   (default: the current branch)
set -euo pipefail

APPLY=0 BRANCHES=()
for a in "$@"; do
  case "$a" in --apply) APPLY=1 ;; *) BRANCHES+=("$a") ;; esac
done
BRANCHES=("${BRANCHES[@]:-$(git branch --show-current)}")

QUERY='
query ($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      comments(first: 100) {
        nodes { id body isMinimized author { login } }
      }
      reviews(first: 100) {
        nodes { id body isMinimized author { login } }
      }
      reviewThreads(first: 100) {
        nodes {
          isResolved
          comments(first: 1) {
            nodes { author { login } pullRequestReview { id } }
          }
        }
      }
    }
  }
}'

MUTATION='
mutation ($id: ID!) {
  minimizeComment(input: { subjectId: $id, classifier: RESOLVED }) {
    clientMutationId
  }
}'

hide_codex_comments() {
  local branch=$1 PR targets id label
  PR=$(gh pr view "$branch" --json number -q .number) ||
    { echo "$branch: no PR" >&2; return 1; }

  targets=$(gh api graphql -F owner='{owner}' -F name='{repo}' -F number="$PR" -f query="$QUERY" | jq -r '
    def codex: (.author.login // "") | test("codex"; "i");
    def body:  (.body // "") | gsub("^\\s+|\\s+$"; "");

    .data.repository.pullRequest as $pr

    # reviews that still have an unresolved codex thread
    | [ $pr.reviewThreads.nodes[]
        | select((.comments.nodes[0] | codex) and (.isResolved | not))
        | .comments.nodes[0].pullRequestReview.id ] as $blocked

    # a trigger, or codex with nothing of its own left open
    | ( $pr.comments.nodes[]
        | select((body | ascii_downcase) == "@codex review" or (codex and $blocked == [])) ),
      ( $pr.reviews.nodes[]
        | select(codex and (body != "") and (.id | IN($blocked[]) | not)) )

    | select(.isMinimized | not)
    | "\(.id)\t\(.author.login): \(body | gsub("\\s+"; " ")[0:60])"')

  [[ -n "$targets" ]] || { echo "#$PR ($branch): nothing to hide"; return; }

  while IFS=$'\t' read -r id label; do
    if (( ! APPLY )); then echo "#$PR would hide  $label"; continue; fi
    if gh api graphql -f id="$id" -f query="$MUTATION" >/dev/null 2>&1
    then echo "#$PR hid         $label"
    else echo "#$PR CANNOT HIDE $label" >&2
    fi
  done <<<"$targets"
}

status=0
for branch in "${BRANCHES[@]}"; do
  hide_codex_comments "$branch" || status=1
done
exit $status
